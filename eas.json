{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "testflight": {
      "extends": "production",
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_CLOSR_API_URL": "https://closr.fly.dev",
        "EXPO_PUBLIC_CLOSR_DIAGNOSTICS": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6827766770"
      }
    },
    "testflight": {
      "ios": {
        "ascAppId": "6827766770"
      }
    }
  }
}
